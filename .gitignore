# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# python
__pycache__/
*.py[cod]

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editor/agent state
.serena/
.cursor/
.claude/
.claude-flow/
${HOME}/

# ml
ml/__pycache__/

# supabase CLI local state (project ref / org id — machine-local, not source)
supabase/.temp/

# local scratch output from scripts/dev/*
*.local.csv
v_region_demand.csv
v_sku_velocity.csv
