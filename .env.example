# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (Project Settings -> API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security: keep it out of the browser and out of git.
SUPABASE_SERVICE_ROLE_KEY=
# Only needed by `npm run go-live` / `npm run check:supabase` to apply migrations
# through the Supabase Management API (Account -> Access Tokens).
SUPABASE_ACCESS_TOKEN=

# --- LLM (Google AI Studio -> Get API key) ------------------------------------
# Optional: without it, analyses use the deterministic, fully-cited fallback.
GEMINI_API_KEY=
# Optional fallback chains (comma-separated, tried in order on quota/overload).
# GEMINI_MODELS_SMART=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.5-flash-lite
# GEMINI_MODELS_FAST=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash

# --- Access --------------------------------------------------------------------
# Comma-separated emails allowed to replace the dataset on the Data page.
# Unset = nobody can import (safe default).
ADMIN_EMAILS=
